# =============================================================================
# Supabase – get these keys from either (A) Supabase Cloud or (B) self-hosted Docker
# =============================================================================
# Copy to .env.local and fill in the values below.
# =============================================================================
#
# -----------------------------------------------------------------------------
# Dev server (optional): if "npm run dev" fails with EMFILE / "too many open files"
# or uv_interface_addresses errors, the dev script already sets WATCHPACK_POLLING.
# On Windows, ensure you run "npm run dev" (cross-env sets the env for you).
# If you still see a stale lock error, run: npm run dev:clean
# -----------------------------------------------------------------------------
#

# -----------------------------------------------------------------------------
# Session idle sign-out (Next.js app)
# -----------------------------------------------------------------------------
# After this many milliseconds with no pointer/keyboard/scroll, the client signs out
# and sends the user to /logout. Default is 11 hours if unset. Integer only; 60000–604800000.
# Example 12 hours: NEXT_PUBLIC_IDLE_SESSION_MS=43200000
# NEXT_PUBLIC_IDLE_SESSION_MS=

# -----------------------------------------------------------------------------
# (A) SUPABASE CLOUD – get keys by logging in at https://supabase.com
# -----------------------------------------------------------------------------
# 1. Go to https://supabase.com and sign up / log in.
# 2. Create a new project (or open an existing one).
# 3. In the dashboard: Project Settings (gear icon) → API.
# 4. Copy:
#    - Project URL        → NEXT_PUBLIC_SUPABASE_URL
#    - anon public key     → NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - service_role key    → SUPABASE_SERVICE_ROLE_KEY (optional, server-only)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# (B) SELF-HOSTED DOCKER – keys come from your local Supabase stack (no login)
# -----------------------------------------------------------------------------
# 1. Clone and start: git clone --depth 1 https://github.com/supabase/supabase && cd supabase/docker
# 2. cp .env.example .env && ./utils/generate-keys.sh && docker compose up -d
# 3. Copy from supabase/docker/.env into this file:
#    - API_EXTERNAL_URL or use http://localhost:8000 → NEXT_PUBLIC_SUPABASE_URL
#    - ANON_KEY        → NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - SERVICE_ROLE_KEY → SUPABASE_SERVICE_ROLE_KEY (optional)
# -----------------------------------------------------------------------------

# Public URL of your Supabase API (used by the browser and by default by the Next.js server).
# - Supabase Cloud: https://<project-ref>.supabase.co (from dashboard → Settings → API)
# - Self-hosted, same PC only: http://localhost:8000
# - Self-hosted, access from other PCs: http://<SERVER_IP>:8000 (e.g. http://192.168.1.100:8000)
#   See docs/ACCESS_FROM_OTHER_PCS.md if login fails with ERR_CONNECTION_REFUSED from another system.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

# Optional: Kong port for dev when NEXT_PUBLIC_SUPABASE_URL is http://localhost with NO :port in the URL
# and you open the app via a LAN hostname (client rewrites API host). Default 8000. Use e.g. 7100 if
# you set KONG_HTTP_PORT=7100 in supabase/docker/.env to avoid clashing with another service on 8000.
# NEXT_PUBLIC_SUPABASE_LOCAL_API_PORT=7100

# Optional: Supabase URL for service-role server code only (getSupabaseAdminClient / some API routes).
# Do NOT expect middleware to use this — middleware always uses NEXT_PUBLIC_SUPABASE_URL so auth
# cookies (sb-<host>-auth-token) match the browser. Use internal URL here to speed admin calls;
# omit to use NEXT_PUBLIC_SUPABASE_URL for admin too.
# SUPABASE_URL=http://127.0.0.1:8000
# Example if Kong listens on 7100: SUPABASE_URL=http://127.0.0.1:7100
# SUPABASE_URL=

# Anonymous (public) key. Safe in the browser when RLS is enabled.
# - Supabase Cloud: from dashboard → Project Settings → API → anon public
# - Self-hosted: from supabase/docker/.env → ANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key. Server-only; never expose in the browser (bypasses RLS).
# Required for: creating users, admin operations. Get it from Supabase:
# - Supabase Cloud: Project Settings → API → service_role (secret)
# - Self-hosted: from supabase/docker/.env → SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
