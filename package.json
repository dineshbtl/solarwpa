{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "build": "next build --webpack",
    "dev": "cross-env WATCHPACK_POLLING=true next dev --webpack",
    "dev:port": "cross-env WATCHPACK_POLLING=true next dev --webpack -p ${PORT:-3000}",
    "dev:3003": "cross-env WATCHPACK_POLLING=true next dev --webpack -p 3003",
    "dev:7100": "cross-env WATCHPACK_POLLING=true next dev --webpack -p 7100",
    "dev:clean": "node -e \"try{require('fs').rmSync('.next/dev/lock',{force:true})}catch(e){}\" && cross-env WATCHPACK_POLLING=true next dev --webpack",
    "dev:clean:3001": "node -e \"try{require('fs').rmSync('.next/dev/lock',{force:true})}catch(e){}\" && cross-env WATCHPACK_POLLING=true next dev --webpack -p 3001",
    "lint": "eslint .",
    "check:user-auth": "node scripts/check-user-auth-flow.mjs",
    "check:user-auth-one": "node scripts/check-single-user-auth.mjs",
    "ensure:role-users": "node scripts/ensure-all-role-users.mjs",
    "start": "next start",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop solar-epc",
    "pm2:restart": "pm2 restart solar-epc --update-env",
    "pm2:reload": "pm2 delete solar-epc 2>/dev/null; pm2 start ecosystem.config.cjs",
    "pm2:update": "pm2 update",
    "pm2:list": "pm2 list",
    "pm2:logs": "pm2 logs solar-epc",
    "pm2:save": "pm2 save",
    "test": "vitest run"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.93.3",
    "@zxing/browser": "^0.2.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.1",
    "exifr": "^7.1.3",
    "input-otp": "1.4.1",
    "lucide-react": "^0.454.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.2.0",
    "react-day-picker": "9.8.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.60.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
